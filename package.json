{
	"name": "smartify-os-editor",
	"private": true,
	"version": "0.1.2",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "bun scripts/build.ts",
		"dist": "bun run build && electron-builder",
		"dist:dir": "bun run build && electron-builder --dir",
		"start": "electron .",
		"postinstall": "install-electron && svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p electron/tsconfig.json && prettier --check . && bun scripts/check-dashes.ts",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p electron/tsconfig.json",
		"release": "bun scripts/release.ts"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@iconify-json/logos": "^1.2.16",
		"@iconify-json/lucide": "^1.2.145",
		"@iconify-json/mdi": "^1.2.3",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"electron": "^44.8.0",
		"electron-builder": "^26.17.0",
		"esbuild": "^0.28.2",
		"picocolors": "^1.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"electron-updater": "^6",
		"koffi": "^3.3.3"
	},
	"trustedDependencies": [
		"koffi"
	],
	"productName": "SmartifyOS Editor",
	"description": "The SmartifyOS editor: build your car's infotainment system with a live preview",
	"author": {
		"name": "SmartifyOS"
	},
	"license": "MIT",
	"main": "out/main/main.cjs"
}
